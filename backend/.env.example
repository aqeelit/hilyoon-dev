# Hilyoon AI Blog Automation Environment Variables
# Copy this to .env and update with your actual values

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id-here

# Database Configuration
DB_HOST=localhost
DB_NAME=hilyoon_saas
DB_USER=root
DB_PASS=

# RSS Feed Sources (comma-separated)
RSS_FEEDS=https://www.microsoft.com/en-us/research/feed/,https://nlp.fast.ai/feed.xml,https://feeds.feedburner.com/nvidiablog

# Blog Generation Settings
POSTS_PER_GENERATION=1
GENERATION_LANGUAGES=en,ro,ar
AUTOMATION_ENABLED=true
GENERATION_INTERVAL_HOURS=6

# Image Generation Settings
IMAGE_QUALITY=hd
IMAGE_SIZE=1792x1024
IMAGE_STYLE=natural

# Rate Limiting
MAX_GENERATIONS_PER_HOUR=10
TOKENS_LIMIT_PER_DAY=50000

# File Paths
LOG_PATH=../logs/
IMAGES_PATH=../public/images/blog/
LOCK_FILE_PATH=../logs/blog_automation.lock

# Security
CRON_SECRET=   # generate: php -r "echo bin2hex(random_bytes(32));"
ADMIN_ONLY_ACCESS=true

# Debugging
DEBUG_MODE=false
LOG_LEVEL=INFO

# Backup Settings
BACKUP_GENERATIONS=true
KEEP_LOGS_DAYS=30
KEEP_IMAGES_DAYS=365
