# Files that run on Linux (containers / server) must keep LF line endings,
# even when checked out on Windows.
*.sh              text eol=lf
Dockerfile        text eol=lf
*.caddy           text eol=lf
Caddyfile         text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.conf            text eol=lf
*.ini             text eol=lf
.dockerignore     text eol=lf
.env*.example     text eol=lf
*.php             text eol=lf
*.sql             text eol=lf
