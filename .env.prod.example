# Hilyoon production settings. Copy to .env on the server (never commit .env).
# Generate each secret with:  openssl rand -hex 32

DOMAIN=hilyoon.com

# Database (MariaDB container)
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Required by the PHP backend; it refuses to start without them (64 hex chars)
JWT_SECRET=
CRON_SECRET=

# Optional: enables AI blog generation
OPENAI_API_KEY=

# Image tag to run (default: latest)
HILYOON_TAG=latest
